{
  "name": "n8n-nodes-moon",
  "version": "0.1.0",
  "description": "n8n nodes for MOON Chat (AI chatbot) and MOON Post (AI content writer)",
  "license": "MIT",
  "homepage": "https://github.com/themoonagency/n8n-nodes-moon#readme",
  "keywords": [
    "n8n-community-node-package",
    "moon chat",
    "moon post",
    "chatbot",
    "leads",
    "content"
  ],
  "author": {
    "name": "Felix Online Concept SRL (THE MOON Agency)",
    "email": "felix.dumitru@themoonagency.ro"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/themoonagency/n8n-nodes-moon.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MoonChatApi.credentials.js",
      "dist/credentials/MoonPostApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MoonChat/MoonChat.node.js",
      "dist/nodes/MoonChatTrigger/MoonChatTrigger.node.js",
      "dist/nodes/MoonPost/MoonPost.node.js",
      "dist/nodes/MoonPostTrigger/MoonPostTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}